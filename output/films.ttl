@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ont:Actor a rdfs:Class ;
    rdfs:label "Actor"@en ;
    rdfs:subClassOf foaf:Person .

ont:Country a rdfs:Class ;
    rdfs:label "Country"@en .

ont:Director a rdfs:Class ;
    rdfs:label "Director"@en ;
    rdfs:subClassOf foaf:Person .

ont:Film a rdfs:Class ;
    rdfs:label "Film"@en .

ont:Genre a rdfs:Class ;
    rdfs:label "Genre"@en .

